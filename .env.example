# ──────────────────────────────────────────────
# MedTech Review — Environment Variables
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to version control
# ──────────────────────────────────────────────

# Base URL of the site (no trailing slash)
# Used for sitemap.xml, canonical tags, and Open Graph meta
NEXT_PUBLIC_SITE_URL=https://medtechreview.com

# Affiliate tracking prefix appended to all /go/ links
# Leave blank to use plain destination URLs
NEXT_PUBLIC_AFFILIATE_TAG=

# Google Analytics 4 Measurement ID (optional)
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console verification token (optional)
# Added as <meta name="google-site-verification"> in layout
NEXT_PUBLIC_GSC_VERIFICATION=
